# Multi-stage Standalone Dockerfile for Nimbus
# Builds React Frontend + FastAPI Backend into a single unified container
# Perfect for Hugging Face Spaces, Render, Railway, Fly.io, or AWS ECS.

# ---- Stage 1: Build React Frontend ----------------------------------------
FROM node:22-alpine AS frontend-builder
WORKDIR /app/frontend

COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci --no-audit --no-fund || npm install --no-audit --no-fund

COPY frontend/ .
ARG VITE_API_BASE_URL=""
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build

# ---- Stage 2: Python Backend & Unified Runtime ----------------------------
FROM python:3.12-slim AS runtime

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=7860 \
    STATIC_DIR=/app/static \
    DATABASE_URL="sqlite+pysqlite:////app/data/nimbus.db" \
    LLM_PROVIDER=openai

WORKDIR /app

RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential libpq5 curl \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --create-home --uid 10001 nimbus \
 && mkdir -p /app/data /app/storage \
 && chown -R nimbus:nimbus /app

COPY backend/requirements.txt .
RUN pip install --upgrade pip \
 && pip install -r requirements.txt

COPY --chown=nimbus:nimbus backend/ /app/
COPY --from=frontend-builder --chown=nimbus:nimbus /app/frontend/dist /app/static

USER nimbus
EXPOSE 7860

CMD ["sh", "-c", "alembic upgrade head 2>/dev/null || true; python scripts/seed.py 2>/dev/null || true; uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-7860}"]
