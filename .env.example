# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
APP_NAME="Nimbus SaaS Platform"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-0000000000000000000000000000000000000000
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
JWT_ALGORITHM=HS256

# ---------------------------------------------------------------------------
# Database (pgvector-enabled Postgres)
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=nimbus
POSTGRES_PASSWORD=nimbus
POSTGRES_DB=nimbus
# Optional full override; takes precedence over the parts above.
# DATABASE_URL=postgresql+psycopg://nimbus:nimbus@localhost:5432/nimbus

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ---------------------------------------------------------------------------
# LLM / RAG
# ---------------------------------------------------------------------------
# One of: openai | fake
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_MIN_SCORE=0.15

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=10485760
