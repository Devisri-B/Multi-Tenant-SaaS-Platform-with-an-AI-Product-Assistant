# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
APP_NAME="Nimbus SaaS Platform"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-0000000000000000000000000000000000000000
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
JWT_ALGORITHM=HS256

# ---------------------------------------------------------------------------
# Database (pgvector-enabled Postgres)
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=nimbus
POSTGRES_PASSWORD=nimbus
POSTGRES_DB=nimbus
# Optional full override; takes precedence over the parts above.
# DATABASE_URL=postgresql+psycopg://nimbus:nimbus@localhost:5432/nimbus

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ---------------------------------------------------------------------------
# LLM / RAG
# ---------------------------------------------------------------------------
# One of: anthropic | fake
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5
# One of: sentence_transformers | fake (embeddings run locally; no API key needed)
EMBEDDING_PROVIDER=sentence_transformers
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
RAG_CHUNK_SIZE=250
RAG_CHUNK_OVERLAP=40
RAG_TOP_K=5
RAG_MIN_SCORE=0.40

# ---------------------------------------------------------------------------
# MCP Server (app.mcp.server)
# ---------------------------------------------------------------------------
# Comma-separated workspace UUIDs the MCP server may expose. Empty = every
# active workspace (fine for a local stdio server; restrict it otherwise).
MCP_ALLOWED_TENANT_IDS=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=10485760
